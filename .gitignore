# Environment
backend/.env
backend/game.db

# Portraits (large files, regenerated locally)
backend/static/portraits/

# Python
__pycache__/
*.pyc
venv/
backend/venv/

# Node
frontend/node_modules/

# Audio WAV masters (~700MB source-of-truth; the shipped, playable OGGs live in
# frontend/public/audio/ and ARE committed — regenerate OGGs from masters with
# frontend/scripts/encode_audio.mjs). Masters themselves are too large for git.
audio_masters/

# pywebview's Edge WebView2 runtime profile/cache — regenerated on launch
webview_data/

# ComfyUI
ComfyUI/
*.mp3

# PyInstaller build artifacts (the packaged .exe is large/binary and fully
# regenerable from app_launcher.py + Everspire.spec — rebuild locally
# with `pyinstaller Everspire.spec` instead of committing it;
# frontend/dist/ stays tracked since the packaged exe needs it present)
/build/
/dist/
*.exe
/build_venv/

# Player save data + local DB backups — personal state, never committed
backend/saves/
backend/db_backups/

# Arena server runtime state (accounts/tokens/match history + its own
# per-profile snapshots) — regenerated by the server, never committed
arena_server/arena.db
arena_server/saves/

# Local agent/tooling state
.agent/
.claude/

# Personal deployment runbook + host details (server IP, SSH user, key paths).
# Never commit these — a public repo shouldn't hand out recon for the VM.
deploy/*.local.md
deploy/*.local.env

# Build output. `python tools/make_release.py` stages the whole shippable game
# here (~3GB) and zips it. Regenerable, never committed — and a stale copy is
# worse than none, since it contains a full second copy of backend/ that can be
# mistaken for source.
release/
build/
dist/

# One-time originals kept by tools/recut_hero_cutouts.py so a bad re-cut can be
# rolled back. Local safety net, not art.
*.prev.bak

# Stray root-level save DB. backend/saves/ was already ignored but this one
# wasn't, so a personal save was one `git add -A` from being committed.
/saves/

# Regenerable review artifact (tools/recut_hero_cutouts.py writes it).
docs/cutout-repair.png

# Generation review artifacts (regenerable; sheets are large PNGs).
docs/showcase/
docs/equipment-sample/
docs/inpaint-poc/

# Retired manhwa-derived art, archived at migration rather than deleted.
backend/static/portraits/_archive_manhwa_*/
backend/static/portraits/_base_pool_staging/
backend/static/portraits/_enemies_staging/
frontend/public/images/_floors_staging/
frontend/public/images/_floor_library_floorsv1/
